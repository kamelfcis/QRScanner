# Customer env (set on Vercel — do not commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_NAME=AlTounsi Store
NEXT_PUBLIC_APP_NAME_AR=التونسي ستور
NEXT_PUBLIC_APP_URL=https://altounsi-store.engazqr.com
NEXT_PUBLIC_SITE_URL=https://altounsi-store.engazqr.com
# restaurant (default) | ecommerce — hides dine-in/takeaway toggles
NEXT_PUBLIC_STORE_MODE=ecommerce
# Customer entry path for menu links and QR codes (/welcome for restaurants, /menu for stores)
NEXT_PUBLIC_QR_TARGET_PATH=/menu
# Leave empty until this store has its own InstaPay link. Do not use another tenant's handle.
NEXT_PUBLIC_INSTAPAY_URL=
NEXT_PUBLIC_INSTAPAY_HANDLE=
