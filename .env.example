# ============================================================
# Copy to .env.local and fill with YOUR project's values
#   cp .env.example .env.local
#
# For Harameen Wholesale Market (harameen branch), use the
# Harameen Supabase project + https://harameen.vercel.app
# Aligned with src/lib/env.ts
# ============================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://twaiccdmimujrbumwrck.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only -- never expose to the browser / NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App identity & URLs ---
# Display name (used by the app; default is Harameen Wholesale Market)
NEXT_PUBLIC_APP_NAME=سوق الجملة شركة الحرمين

# Canonical app URL (local or production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public site URL for SEO / sitemap / Open Graph
# Production: https://harameen.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional login theme selector: harameen | aklet | warda
# If unset, inferred from NEXT_PUBLIC_APP_NAME / NEXT_PUBLIC_SITE_URL
# NEXT_PUBLIC_TENANT=harameen

# QR code landing path (Harameen: / homepage)
NEXT_PUBLIC_QR_TARGET_PATH=/

# Fulfillment mode: set to delivery_only for wholesale / supermarket (Harameen)
# Shows only Delivery on /welcome; hides dine-in & takeaway pickers
NEXT_PUBLIC_FULFILLMENT_MODE=delivery_only

# --- Optional: AI menu import (Dashboard -> Import) ---
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3-flash-preview
