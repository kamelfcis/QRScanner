# Customer env (set on Vercel — do not commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_NAME=أسطول سي فود
NEXT_PUBLIC_APP_URL=https://ostol-seafood.engazqr.com
NEXT_PUBLIC_SITE_URL=https://ostol-seafood.engazqr.com
NEXT_PUBLIC_QR_TARGET_PATH=/welcome

# Login visual theme: warda | aklet | harameen | custom
# Use custom for provisioned customers (settings-driven branding only)
# Tenant flags stay ala-keefak so existing feature gates remain on
# (dark storefront, 4 sizes, daily ops). Displayed app name and URLs are Ostol Seafood.
NEXT_PUBLIC_TENANT=ala-keefak

# Default language on first visit (ar | en | fr | nl). Omit for Arabic.
# NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Comma-separated UI locales for this deployment (e.g. ar,en). Omit for all four.
# NEXT_PUBLIC_ENABLED_LOCALES=ar,en

# Set to true on deployments that should hide landing "Signature Dishes"
# NEXT_PUBLIC_HIDE_FEATURED_DISHES=true

# Set to true on deployments that should hide landing gallery preview
# NEXT_PUBLIC_HIDE_LANDING_GALLERY=true

# Use "items" copy (أصناف مميزة) instead of dishes (أطباق مميزة) — spices shops
# NEXT_PUBLIC_FEATURED_COPY=items

# Web Push. Set on Vercel — never commit the private key.
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@ostol-seafood.engazqr.com

# AI product images: gemini (default) or openai
# AI_IMAGE_PROVIDER=openai

# Gemini (server-only — never commit real keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_VISION_MODEL=gemini-2.5-flash

# OpenAI (server-only — never commit real keys; use on ostol-seafood when AI_IMAGE_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VISION_MODEL=gpt-4o-mini
