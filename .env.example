# ============================================================
# Engaz Admin (control plane) — copy to .env.local
# NEVER commit real secrets.
# ============================================================

# --- Engaz Admin Supabase (dedicated project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_ENGAZ_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-engaz-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-engaz-service-role-key

# --- App ---
NEXT_PUBLIC_APP_NAME=Engaz Admin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AES-256-GCM key: 32 random bytes, base64-encoded
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENGAZ_SECRETS_KEY=

# --- GitHub (private monorepo kamelfcis/QRScanner) ---
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_REPO=kamelfcis/QRScanner

# --- Vercel ---
VERCEL_TOKEN=xxxxxxxx
# Optional if project is under a team
VERCEL_TEAM_ID=
