# ============================================================
# Copy to .env.local and fill with YOUR project's values
#   cp .env.example .env.local
#
# For a new restaurant clone (e.g. أكلة جمبري أنا), use a NEW
# Supabase project + NEW site URL -- do not reuse Warda production.
# Aligned with src/lib/env.ts
# ============================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only -- never expose to the browser / NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App identity & URLs ---
# Display name (used by the app; override Warda default)
NEXT_PUBLIC_APP_NAME=Doctor Burger

# Canonical app URL (local or production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public site URL for SEO / sitemap / Open Graph
# Production example: https://aklagambariana.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: AI menu import (Dashboard -> Import) ---
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3-flash-preview
